#!/bin/sh
# Sourced by lefthook before every hook command.
# Makes mise-managed tools (and node_modules/.bin via mise [env]) available even when
# git is invoked from an IDE or GUI client whose PATH was never mise-activated.
PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"
export PATH
if command -v mise >/dev/null 2>&1; then
  eval "$(mise env --shell bash)"
fi
